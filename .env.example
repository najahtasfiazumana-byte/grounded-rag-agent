# Copy this file to .env and fill in what you use. .env is git-ignored: never commit it,
# and never paste your key into chats, issues or screenshots.

# Which LLM to use: gemini | claude | ollama | mock
# If unset: gemini when GEMINI_API_KEY is set, else claude when ANTHROPIC_API_KEY is set, else mock (offline).
RAG_AGENT_PROVIDER=gemini

# Google Gemini - free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# How long newer Gemini models 'think' first: low (fast, default) / medium / high
# GEMINI_THINKING_LEVEL=low
# Embedding model, only used with `rag-agent ingest --embeddings gemini`
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Anthropic Claude - key from https://platform.claude.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Ollama - local, free. Install from https://ollama.com and `ollama pull llama3.1`
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Live web search fallback: ddgs (no key) | wikipedia (no key) | tavily | mock | none
# Overrides web.provider in config.yaml.
# RAG_AGENT_WEB_SEARCH=ddgs
# Tavily free key (1,000 searches/month) from https://tavily.com - only if you pick tavily
TAVILY_API_KEY=

# Seconds to wait for an LLM answer before giving up (default 180)
# RAG_AGENT_LLM_TIMEOUT=180
